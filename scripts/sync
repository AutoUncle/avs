#!/usr/bin/env bash
# Copies schema/avs.schema.json and VERSION into every package and regenerates the
# TypeScript and Python types. Run after changing schema/ or VERSION; CI fails if
# this leaves a diff. Needs node (with packages/npm installed) and uv.
# PHP reads schema/ directly (composer installs the whole repository), so it needs nothing.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(tr -d '[:space:]' < VERSION)
schema=schema/avs.schema.json

# Ruby
cp "$schema" packages/ruby/lib/avs/avs.schema.json
cat > packages/ruby/lib/avs/version.rb <<RUBY
# Generated by scripts/sync from /VERSION. Do not edit.
module AVS
  VERSION = "$version"
end
RUBY

# npm
cp "$schema" packages/npm/src/avs.schema.json
(cd packages/npm && npm pkg set version="$version" >/dev/null && npm run --silent generate)

# Python
cp "$schema" packages/python/src/avs/avs.schema.json
sed -i.bak -E "s/^version = \".*\"/version = \"$version\"/" packages/python/pyproject.toml && rm packages/python/pyproject.toml.bak
uv tool run --quiet --python 3.12 --from datamodel-code-generator==0.26.5 datamodel-codegen \
  --input "$schema" --input-file-type jsonschema --output-model-type typing.TypedDict \
  --class-name AvsDocument --target-python-version 3.9 --use-schema-description --disable-timestamp \
  --custom-file-header "# Generated by scripts/sync from avs.schema.json. Do not edit." \
  --output packages/python/src/avs/types.py

# Go (version comes from the packages/go/vX.Y.Z tag)
cp "$schema" packages/go/avs.schema.json

# Java
cp "$schema" packages/java/src/main/resources/com/autouncle/avs/avs.schema.json
# The first <version> in the pom is the project's own.
perl -0pi -e "s|<version>[^<]*</version>|<version>$version</version>|" packages/java/pom.xml

# .NET
cp "$schema" packages/dotnet/src/AutoUncle.Avs/avs.schema.json
sed -i.bak -E "s|<Version>[^<]*</Version>|<Version>$version</Version>|" packages/dotnet/src/AutoUncle.Avs/AutoUncle.Avs.csproj
rm packages/dotnet/src/AutoUncle.Avs/AutoUncle.Avs.csproj.bak
